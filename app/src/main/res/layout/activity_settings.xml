<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <include layout="@layout/view_header" />

        <LinearLayout
            style="@style/Widget.AirGest.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_fps"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/fpsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/fps30"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="30"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/fps24"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="24"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/fps15"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15"
                    android:textColor="@color/text_primary" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AirGest.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCursor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_cursor"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:id="@+id/cursorSizeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchHud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_hud"
                android:textColor="@color/text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInvert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_invert_scroll"
                android:textColor="@color/text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_boot"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Widget.AirGest.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_boot_hint" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.AirGest.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <TextView
                style="@style/Widget.AirGest.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_battery_hint" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBattery"
                style="@style/Widget.AirGest.SmallButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_battery" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
